# StorySense Backend Environment Variables
# Copy this file to .env and fill in your real API keys.

# TMDB API Key (for movie/TV poster enrichment)
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Authentication
JWT_SECRET_KEY=your_super_secret_jwt_key_here_please_change_in_production
JWT_ALGORITHM=HS256
